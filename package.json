{
  "name": "sfdx-plugin-source-read",
  "version": "0.0.0-development",
  "description": "sfdx plugin to read Metadata e.g. full Profiles via CRUD Metadata API",
  "keywords": [
    "sfdx-plugin",
    "sf-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amtrack/sfdx-plugin-source-read.git"
  },
  "license": "MIT",
  "author": "Matthias Rolke @amtrack",
  "type": "module",
  "exports": "./lib/index.js",
  "bin": {
    "sfdx-plugin-source-read": "bin/run.js"
  },
  "files": [
    "/bin",
    "/lib",
    "/oclif.manifest.json"
  ],
  "scripts": {
    "build": "rm -rf lib && tsc -p . && oclif manifest",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "format": "prettier --write src test bin",
    "test": "tsc -p test && mocha \"test/**/*.test.ts\"",
    "test:e2e": "tsc -p test && mocha --timeout 60000 \"test/**/*.e2e.ts\""
  },
  "mocha": {
    "loader": "ts-node/esm",
    "no-warnings": "ExperimentalWarning"
  },
  "oclif": {
    "additionalHelpFlags": [
      "-h"
    ],
    "bin": "sf",
    "commands": "./lib/commands",
    "topicSeparator": " ",
    "topics": {
      "crud-mdapi": {
        "description": "Work with the CRUD Metadata API."
      }
    }
  },
  "dependencies": {
    "@salesforce/sf-plugins-core": "13.0.0",
    "@salesforce/source-deploy-retrieve": "13.1.1"
  },
  "devDependencies": {
    "@salesforce/dev-scripts": "13.0.2",
    "execa": "10.0.1",
    "oclif": "4.23.30"
  }
}
